---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSondaView } from '../lib/sonda-build.js';
import { VOTE, IDENTITY, CONTACTS, SONDA_LINKS } from '../data/solya.js';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const sonda = await getSondaView();
const place = sonda.place || 'Asia-Pacific';

const {
  title = `Solya · Solana Validator | 0% Commission · ${place} · SONDA`,
  description = `Independent Solana validator since 2021. 0% commission, SFDP approved, DoubleZero and Jito BAM, hosted in ${place}. Builder of SONDA, open-source validator analytics.`,
  ogImage = '/og-image.jpg',
  canonicalUrl = Astro.url.href,
} = Astro.props;

// Social scrapers need absolute image URLs.
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Solya Solana Validator',
  url: 'https://solya.studio',
  logo: 'https://solya.studio/logo.jpg',
  description: `Independent Solana validator since 2021 with 0% commission, hosted in ${place}. Builder of SONDA, an open-source observatory for Solana validators. Genesis validator on the Alpenglow community cluster.`,
  sameAs: [
    CONTACTS.github.url,
    CONTACTS.x.url,
    `https://stakewiz.com/validator/${VOTE}`,
    `https://www.validators.app/validators/${IDENTITY}?locale=en&network=mainnet`,
    SONDA_LINKS.validator,
    SONDA_LINKS.site,
    SONDA_LINKS.x,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Solya Validator" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@SolyaOS" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Fonts preconnect (the stylesheet is imported in global.css) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Privacy-friendly analytics by Plausible -->
    <script is:inline async src="https://plausible.io/js/pa-0fOKzZ4nh_RY3KgpWwngS.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>

    <!-- Theme: detect system preference, respect localStorage -->
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        if (stored) {
          document.documentElement.setAttribute('data-theme', stored);
        } else {
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
        }
      })();
    </script>
  </head>

  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer place={place} />

    <script>
      // Scroll fade-in
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add('visible');
          });
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));

      // Plausible custom events: any element with data-track="Event name"
      // (optional data-track-place) sends one event on click.
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-track]');
        if (!el) return;
        const w = window as unknown as { plausible?: (name: string, opts?: object) => void };
        w.plausible?.(el.dataset.track || 'Click', { props: { place: el.dataset.trackPlace || '' } });
      });

      // Copy buttons: any element with data-copy="value".
      document.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-copy]');
        if (!btn) return;
        const value = btn.dataset.copy || '';
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = value;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
        btn.classList.add('is-copied');
        const label = btn.querySelector<HTMLElement>('[data-copy-label]');
        const before = label?.textContent;
        if (label) label.textContent = 'Copied!';
        setTimeout(() => {
          btn.classList.remove('is-copied');
          if (label && before != null) label.textContent = before;
        }, 1800);
        const w = window as unknown as { plausible?: (name: string, opts?: object) => void };
        if (btn.dataset.copyWhat === 'vote account') {
          w.plausible?.('Copy Vote Account', { props: { place: btn.dataset.trackPlace || 'card' } });
        }
      });

      // Instant tooltips for any element with data-tip (native title tooltips
      // wait about a second). One floating element, positioned on hover/focus.
      const tip = document.createElement('div');
      tip.className = 'tip';
      tip.setAttribute('role', 'tooltip');
      document.body.appendChild(tip);
      let tipTarget: HTMLElement | null = null;
      let tipTimer = 0;
      const showTip = (el: HTMLElement) => {
        const text = el.dataset.tip;
        if (!text) return;
        tipTarget = el;
        tip.textContent = text;
        tip.classList.add('is-on');
        const r = el.getBoundingClientRect();
        const t = tip.getBoundingClientRect();
        const left = Math.max(8, Math.min(r.left + r.width / 2 - t.width / 2, window.innerWidth - t.width - 8));
        let top = r.top - t.height - 8;
        if (top < 72) top = r.bottom + 8; // stay clear of the fixed header
        tip.style.left = `${left}px`;
        tip.style.top = `${top}px`;
      };
      const hideTip = () => {
        tipTarget = null;
        tip.classList.remove('is-on');
      };
      document.addEventListener('mouseover', (e) => {
        const el = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-tip]');
        if (el && el !== tipTarget) showTip(el);
        else if (!el && tipTarget) hideTip();
      });
      document.addEventListener('focusin', (e) => {
        const el = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-tip]');
        if (el) showTip(el);
      });
      document.addEventListener('focusout', hideTip);
      window.addEventListener('scroll', hideTip, { passive: true });
      document.addEventListener('touchstart', (e) => {
        const el = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-tip]');
        if (!el) return;
        showTip(el);
        window.clearTimeout(tipTimer);
        tipTimer = window.setTimeout(hideTip, 2500);
      }, { passive: true });

      // Email link: the address is assembled here so it never sits in the HTML.
      document.querySelectorAll<HTMLAnchorElement>('[data-mail]').forEach((a) => {
        const addr = atob(a.dataset.mail || '');
        a.href = `mailto:${addr}`;
        const text = a.querySelector<HTMLElement>('[data-mail-text]');
        if (text) text.textContent = addr;
      });
    </script>
  </body>
</html>
