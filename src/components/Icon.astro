---
// src/components/Icon.astro
// Inline SVG icons. Used instead of emoji, which some browsers (Firefox on
// macOS among them) draw as empty boxes. Line icons use currentColor.

interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 20, class: className = '', label } = Astro.props;

// Line icons: stroke-based, 24x24 grid.
const LINE: Record<string, string> = {
