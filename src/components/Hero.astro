---
// src/components/Hero.astro
import Icon from './Icon.astro';
import { getSondaView } from '../lib/sonda-build.js';
import { yearsSince } from '../lib/sonda.js';
import { VOTE, CURRENT_LOCATION, RUNNING_SINCE } from '../data/solya.js';

const sonda = await getSondaView();
const years = yearsSince(RUNNING_SINCE.year, RUNNING_SINCE.month);

// The story line is used only while SONDA agrees on the country.
const storyMatches = sonda.cc === CURRENT_LOCATION.countryCode;
const locationLine = storyMatches
  ? `Running from ${CURRENT_LOCATION.place} since ${CURRENT_LOCATION.from}, a location with little stake concentration that we chose with SONDA.`
  : `Running from ${sonda.place}.`;
---

<section class="hero" id="hero">

  <!-- Background layers -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-glow hero-bg-glow--crimson"></div>
    <div class="hero-bg-glow hero-bg-glow--cyan"></div>
    <div class="hero-bg-grid"></div>
  </div>

  <div class="container hero-inner">

    <!-- Badges -->
    <div class="hero-badges">
      <span class="badge badge-cyan">
        <span class="badge-dot badge-dot--live"></span>
        Active
      </span>
      <span class="badge badge-cyan">SFDP Approved</span>
      <span class="badge badge-cyan">DoubleZero</span>
      <span class="badge badge-cyan">Jito BAM</span>
      <span class="badge badge-cyan">Alpenglow Genesis</span>
      <span class="badge badge-magenta">SONDA</span>
    </div>

    <!-- Main headline -->
    <h1 class="hero-title">
      Solya<br />
      <span class="gradient-text">Independent<br />Solana Validator</span>
    </h1>

    <!-- Subheadline -->
    <p class="hero-sub">
      0% commission on inflation rewards and MEV. We build open-source tools
      for the Solana ecosystem, including SONDA. {locationLine}
    </p>

    <!-- Stats -->
    <div class="hero-stats">
      <div class="hero-stat">
        <span class="hero-stat-value">0%</span>
        <span class="hero-stat-label">Commission</span>
      </div>
      <div class="hero-stat-divider" aria-hidden="true"></div>
      <div class="hero-stat">
        <span class="hero-stat-value">0%</span>
        <span class="hero-stat-label">MEV Commission</span>
      </div>
      <div class="hero-stat-divider" aria-hidden="true"></div>
      <div class="hero-stat">
        <span class="hero-stat-value">{sonda.place}</span>
        <span class="hero-stat-label">Location{sonda.region ? ` · ${sonda.region}` : ''}</span>
      </div>
      <div class="hero-stat-divider" aria-hidden="true"></div>
      <div class="hero-stat">
        <span class="hero-stat-value">{years}+</span>
        <span class="hero-stat-label">Years running</span>
      </div>
    </div>

    <!-- CTAs -->
    <div class="hero-ctas">
      <a href="#stake" class="btn-primary hero-cta-primary" data-track="Stake CTA" data-track-place="hero">
        Stake SOL with Solya
      </a>
      <a
        href={`https://stakewiz.com/validator/${VOTE}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary"
      >
        View on StakeWiz
      </a>
    </div>

    <!-- Vote account with copy button -->
    <div class="hero-vote">
      <span class="hero-vote-label">Vote account</span>
      <div class="hero-vote-row">
        <code class="hero-vote-address">{VOTE}</code>
        <button
          class="hero-copy-btn"
          type="button"
          data-copy={VOTE}
          data-copy-what="vote account"
          data-track-place="hero"
          aria-label="Copy vote account address"
        >
          <Icon name="copy" size={14} class="copy-icon-idle" />
          <Icon name="check" size={14} class="copy-icon-done" />
          <span data-copy-label>Copy</span>
        </button>
      </div>
    </div>

  </div>

  <!-- Scroll hint -->
  <div class="hero-scroll-hint" aria-hidden="true">
    <div class="hero-scroll-arrow"></div>
  </div>

</section>
