---

<footer class="site-footer">
  <div class="container footer-inner">

    <!-- Top row: лого + nav + соцмережі -->
    <div class="footer-top">

      <a href="/" class="footer-logo" aria-label="Solya Validator — home">
        <img src="/logo.jpg" alt="Solya" class="footer-logo-img" />
        <span class="footer-logo-text">Solya</span>
      </a>

      <nav class="footer-nav" aria-label="Footer navigation">
        {nav.map((item) => (
          <a href={item.href} class="footer-nav-link">{item.label}</a>
        ))}
      </nav>

      <div class="footer-socials">
        {socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-link"
            aria-label={s.label}
            title={s.label}
            set:html={s.icon}
          />
        ))}
      </div>

    </div>

    <hr class="footer-divider" />

    <!-- Bottom row -->
    <div class="footer-bottom">
      <div class="footer-vote">
        <span class="footer-vote-label">Vote account</span>
        <button class="footer-vote-btn" id="footer-copy-vote" aria-label="Copy vote account" title="Click to copy">
          <code class="footer-vote-addr" id="footer-vote-addr">{VOTE}</code>
          <span class="footer-vote-copied" id="footer-vote-copied">Copied!</span>
        </button>
      </div>

      <p class="footer-copy">
        &copy; {YEAR} Solya Validator &middot; São Paulo &middot;
        <a href="/security">Security</a>
      </p>
    </div>

  </div>
</footer>

<script>
  const btn    = document.getElementById('footer-copy-vote');
  const addr   = document.getElementById('footer-vote-addr');
  const copied = document.getElementById('footer-vote-copied');
  const VOTE   = addr?.textContent?.trim() ?? '';

  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(VOTE);
      addr?.classList.add('hidden');
      copied?.classList.add('visible');
      setTimeout(() => {
        addr?.classList.remove('hidden');
        copied?.classList.remove('visible');
      }, 2000);
    } catch { /* silent */ }
  });
</script>