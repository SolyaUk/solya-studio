---
// src/components/Footer.astro
import Icon from './Icon.astro';
import { VOTE, CONTACTS } from '../data/solya.js';

interface Props {
  place?: string;
}

const { place = '' } = Astro.props;
const YEAR = new Date().getFullYear();

const nav = [
  { label: 'Why Solya', href: '/#why-solya' },
  { label: 'SONDA', href: '/#sonda' },
  { label: 'Ecosystem', href: '/#ecosystem' },
  { label: 'Timeline', href: '/#timeline' },
  { label: 'Stake', href: '/#stake' },
  { label: 'Security', href: '/security/' },
];
---

<footer class="site-footer">
  <div class="container footer-inner">

    <!-- Top row: logo, navigation and contacts -->
    <div class="footer-top">

      <a href="/" class="footer-logo" aria-label="Solya Validator: home">
        <img src="/logo.jpg" alt="Solya" class="footer-logo-img" width="28" height="28" />
        <span class="footer-logo-text">Solya</span>
      </a>

      <nav class="footer-nav" aria-label="Footer navigation">
        {nav.map((item) => <a href={item.href} class="footer-nav-link">{item.label}</a>)}
      </nav>

      <div class="footer-socials">
        <a href={CONTACTS.x.url} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label={`X ${CONTACTS.x.handle}`} title={`X ${CONTACTS.x.handle}`}>
          <Icon name="x" size={15} />
        </a>
        <a href={CONTACTS.telegram.url} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label={`Telegram ${CONTACTS.telegram.handle}`} title={`Telegram ${CONTACTS.telegram.handle}`}>
          <Icon name="telegram" size={15} />
        </a>
        <a href="#" data-mail={CONTACTS.emailB64} class="footer-social-link" aria-label="Email" title="Email">
          <Icon name="mail" size={16} />
        </a>
        <a href={CONTACTS.github.url} target="_blank" rel="noopener noreferrer" class="footer-social-link" aria-label="GitHub" title="GitHub">
          <Icon name="github" size={15} />
        </a>
      </div>

    </div>

    <hr class="footer-divider" />

    <!-- Bottom row -->
    <div class="footer-bottom">
      <div class="footer-vote">
        <span class="footer-vote-label">Vote account</span>
        <button
          class="footer-vote-btn"
          type="button"
          data-copy={VOTE}
          data-copy-what="vote account"
          data-track-place="footer"
          aria-label="Copy vote account"
          title="Click to copy"
        >
          <code class="footer-vote-addr">{VOTE}</code>
          <span class="footer-vote-copied">Copied!</span>
        </button>
      </div>

      <p class="footer-copy">
        &copy; {YEAR} Solya Validator{place && <> &middot; {place}</>} &middot;
        <a href="/security/">Security</a>
      </p>
    </div>

  </div>
</footer>
