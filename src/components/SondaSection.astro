---
// src/components/SondaSection.astro
import Icon from './Icon.astro';
import SondaCard from './SondaCard.astro';
import { getSondaView } from '../lib/sonda-build.js';
import { SONDA_LINKS } from '../data/solya.js';

const sonda = await getSondaView();
const providerUrl = `https://sonda.network/datacenter?provider=${sonda.providerSlug}&cluster=mainnet-beta`;
const placeUrl = `https://sonda.network/validators?cluster=mainnet-beta&country=${sonda.cc}`;

const features = [
  'Validators table with filters by client, version, country, city, provider, DoubleZero and Jito BAM, including exclude filters',
  'Validator profiles with location, infrastructure, performance and links across clusters',
  'Datacenters grouped by provider: cities, stake concentration, network infrastructure and performance',
  'Chain vitals for every cluster: consensus, slot time, throughput and cluster status',
  'Live checks of Jito, Harmonic and Solana endpoints',
  'Where DoubleZero and Jito BAM infrastructure is placed, and which validators are connected to it',
  'Cross-verified geolocation behind every record, with disagreements between sources flagged',
];

interface Tile {
  group: string;
  title: string;
  desc: string;
  href: string;
  icon?: string;
  img?: string | null;
}

const rows: { label: string; items: Tile[] }[] = [
  {
    label: 'Solya',
    items: [
      { group: 'solya', img: '/logo.jpg', icon: 'node', title: 'Solya on SONDA', desc: "Our validator's live profile", href: SONDA_LINKS.validator },
      { group: 'solya', img: sonda.logoUrl, icon: 'server', title: sonda.provider || 'Our provider', desc: 'Our provider: validators, cities, network nodes', href: providerUrl },
      { group: 'solya', img: sonda.cc ? `https://flagcdn.com/w80/${sonda.cc.toLowerCase()}.png` : null, icon: 'globe', title: sonda.place, desc: `Validators in ${sonda.place}`, href: placeUrl },
    ],
  },
  {
    label: 'Mainnet',
    items: [
      { group: 'sonda', icon: 'activity', title: 'Network overview', desc: 'Chain vitals, consensus, decentralization', href: 'https://sonda.network/?cluster=mainnet-beta' },
      { group: 'sonda', icon: 'server', title: 'Datacenters', desc: 'Providers, cities, stake concentration', href: SONDA_LINKS.datacenters },
      { group: 'sonda', icon: 'list', title: 'Validators', desc: 'Filters by client, provider, country', href: SONDA_LINKS.validators },
    ],
  },
  {
    label: 'Clusters',
    items: [
      { group: 'testnet', icon: 'flask', title: 'Testnet', desc: 'Where new releases are tested', href: 'https://sonda.network/?cluster=testnet' },
      { group: 'devnet', icon: 'terminal', title: 'Devnet', desc: 'Rarely covered by other dashboards', href: 'https://sonda.network/?cluster=devnet' },
      { group: 'alpenglow', icon: 'mountain', title: 'Alpenglow', desc: "Solana's new consensus, live", href: SONDA_LINKS.alpenglow },
    ],
  },
  {
    label: 'Updates & code',
    items: [
      { group: 'telegram', icon: 'telegram', title: 'Network events', desc: 'Live alerts in a Telegram channel', href: SONDA_LINKS.telegram },
      { group: 'code', icon: 'github', title: 'Backend code', desc: 'Analyzer and data pipeline', href: SONDA_LINKS.repoBackend },
      { group: 'code', icon: 'code', title: 'Dashboard code', desc: 'The sonda.network frontend', href: SONDA_LINKS.repoFrontend },
    ],
  },
];
---

<section class="section sonda-section" id="sonda">
  <div class="container">
    <div class="sonda-inner">

      <!-- Left: story and features -->
      <div class="sonda-content fade-in">

        <span class="section-label">Open-source project</span>

        <h2 class="sonda-title">
          <span class="sonda-acronym-line"><span class="sonda-letter">S</span><span class="sonda-word">olana</span></span>
          <span class="sonda-acronym-line"><span class="sonda-letter">O</span><span class="sonda-word">bservatory for</span></span>
          <span class="sonda-acronym-line"><span class="sonda-letter">N</span><span class="sonda-word">etwork</span></span>
          <span class="sonda-acronym-line"><span class="sonda-letter">D</span><span class="sonda-word">ecentralization</span></span>
          <span class="sonda-acronym-line"><span class="sonda-letter">A</span><span class="sonda-word">nalysis</span></span>
        </h2>

        <p class="sonda-desc">
          SONDA started in 2023 with a question every operator runs into: where
          should a validator live? The basics were out there: how many
          validators a datacenter hosts, how much stake it holds, which provider
          stands behind an ASN. What was missing was a way to compare
          datacenters by how their validators actually perform, across vote
          credits, skipped slots, block times and more, side by side. That meant
          writing scripts and watching validators by hand. SONDA grew out of
          those scripts.
        </p>

        <p class="sonda-desc">
          Today SONDA is an open-source observatory for Solana validators across
          four clusters: mainnet-beta, testnet, the Alpenglow community cluster
          and devnet, which most validator dashboards leave out. It shows where
          validators run, with which providers and how well, where DoubleZero and
          Jito BAM infrastructure is placed and who is connected to it, and turns
          all of this into practical answers for operators. Mainnet data
          refreshes every minute, and the dashboard is free to use.
        </p>

        <p class="sonda-desc">
          I use SONDA myself to run Solya Validator. The move to Hong Kong in
          September 2026 was decided with it: while building the datacenter
          pages and filters, I compared cities and providers by stake
          concentration, by how their validators perform and by the Jito BAM and
          DoubleZero nodes nearby. You can do the same before choosing your next
          datacenter.
        </p>

        <ul class="sonda-features">
          {features.map((f) => (
            <li class="sonda-feature">
              <span class="sonda-feature-icon" aria-hidden="true">⊕</span>
              <span>{f}</span>
            </li>
          ))}
        </ul>

        <div class="sonda-ctas">
          <a href={SONDA_LINKS.site} target="_blank" rel="noopener noreferrer" class="btn-primary sonda-network-btn">
            <span class="sonda-dot sonda-dot--live"></span>
            Open sonda.network
          </a>
          <a href={SONDA_LINKS.x} target="_blank" rel="noopener noreferrer" class="btn-secondary sonda-x-btn">
            <Icon name="x" size={14} />
            Follow @SondaNetwork
          </a>
        </div>

      </div>

      <!-- Right: Solya on SONDA -->
      <div class="sonda-side fade-in">
        <SondaCard />
      </div>

    </div>

    <!-- Explore SONDA -->
    <div class="sonda-explore fade-in">
      <div class="sonda-explore-label">Explore SONDA</div>
      <div class="explore-rows">
        {rows.map((row) => (
          <div class="explore-row">
            <div class="explore-row-label">{row.label}</div>
            <div class="explore-row-grid">
              {row.items.map((item) => (
                <a href={item.href} target="_blank" rel="noopener noreferrer" class={`explore-link g-${item.group}`}>
                  <span class="explore-icon">
                    <Icon name={item.icon || 'node'} size={20} />
                    {item.img && <img src={item.img} alt="" width="40" height="40" loading="lazy" onerror="this.remove()" />}
                  </span>
                  <span class="explore-text">
                    <span class="explore-title">{item.title}</span>
                    <span class="explore-desc">{item.desc}</span>
                  </span>
                  <Icon name="arrowUpRight" size={14} class="explore-arrow" />
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
