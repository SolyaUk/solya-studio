---
// src/pages/security.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getSondaView } from '../lib/sonda-build.js';
import { VOTE, IDENTITY, ALPENGLOW, TESTNET, LOCATIONS, CURRENT_LOCATION } from '../data/solya.js';

const sonda = await getSondaView();
const storyMatches = sonda.cc === CURRENT_LOCATION.countryCode;
const where = `${sonda.place} (${[sonda.provider, sonda.asn].filter(Boolean).join(', ')})`;
const previous = LOCATIONS.slice(0, -1).reverse().map((l) => `${l.place} (${l.from} to ${l.to})`);
const previousText = previous.length
  ? `Before that, Solya Validator ran in ${previous.slice(0, -1).join(', ')}${previous.length > 1 ? ' and ' : ''}${previous[previous.length - 1]}.`
  : '';
const since = storyMatches ? ` since ${CURRENT_LOCATION.from}` : '';
---

<BaseLayout
  title="Security & Responsibility | Solya Solana Validator"
  description={`How Solya Solana Validator handles infrastructure security, key management and staking safety. Independent validator running since 2021, hosted in ${sonda.place}${since}.`}
>
  <div class="security-page">
    <div class="container">

      <div class="security-header">
        <a href="/" class="security-back"><Icon name="arrowLeft" size={14} /> Back</a>
        <div class="security-label-wrap">
        <span class="section-label">solya.studio/security</span>
        </div>
        <h1 class="security-title">Security &amp; Responsibility</h1>
        <p class="security-intro">
          Solya Validator has run on Solana since 2021, and security is part of its
          daily routine. Here is how the validator is managed and what that
          means for stakers.
        </p>
      </div>

      <div class="security-sections">

        <div class="security-section">
          <h2 class="security-section-title">Your funds are safe by design</h2>
          <div class="security-content">
            <p>
              Staking on Solana is non-custodial. Solya, like any validator on
              the network, has no access to your wallet or staked SOL. The
              Solana protocol handles reward distribution automatically at the
              end of each epoch. You can unstake at any time; funds become
              available when the current epoch ends.{sonda.epochHours
                ? ` With today's faster slots an epoch lasts about ${sonda.epochHours} hours, so the wait is a day or so rather than the two to three days it used to be.`
                : ' Epochs are shorter than they used to be, so the wait is usually about a day.'}
            </p>
          </div>
        </div>

        <div class="security-section">
          <h2 class="security-section-title">Infrastructure</h2>
          <div class="security-content">
            <p>
              The node runs on dedicated hardware in {where}.
              {storyMatches && (
                <>
                  We chose the location and the provider in {CURRENT_LOCATION.from} with
                  the help of SONDA: little stake concentration, Jito BAM and
                  DoubleZero nodes in the same city, and an established provider
                  whose validators perform well.
                </>
              )}
              {' '}{previousText} The server is hardened, access is key-based
              only, and new validator releases run on our testnet node before
              they reach mainnet.
            </p>
            <p>
              The node is connected to DoubleZero{sonda.dz?.device ? ` (${sonda.dz.device})` : ''} for
              filtered, low-latency validator communication, and runs the Jito
              BAM client for verifiable, tamper-resistant transaction scheduling.
            </p>
          </div>
        </div>

        <div class="security-section">
          <h2 class="security-section-title">Key management</h2>
          <div class="security-content">
            <p>
              Identity key, vote key, and withdraw authority are fully separated.
              The withdraw authority is stored offline and never touches the
              validator server. Commission is set to 0% and there are no plans to
              change that. If it ever did change, it would be announced publicly
              well in advance.
            </p>
            <div class="security-keys">
              <div class="security-key-row">
                <span class="security-key-label">Identity</span>
                <code class="security-key-value">{IDENTITY}</code>
              </div>
              <div class="security-key-row">
                <span class="security-key-label">Vote account</span>
                <code class="security-key-value">{VOTE}</code>
              </div>
            </div>
          </div>
        </div>

        <div class="security-section">
          <h2 class="security-section-title">Alpenglow community cluster</h2>
          <div class="security-content">
            <p>
              Solya also runs a validator on the Alpenglow community cluster
              (since wave 2, May 2026). This is an isolated network with
              completely separate identity and vote keys that have no
              relationship to the mainnet validator or its withdraw authority.
              Participation in the Alpenglow cluster cannot affect mainnet
              stakers in any way: different network, different keys, no
              shared funds.
            </p>
            <div class="security-keys">
              <div class="security-key-row">
                <span class="security-key-label">Alpenglow identity</span>
                <code class="security-key-value">{ALPENGLOW.identity}</code>
              </div>
              <div class="security-key-row">
                <span class="security-key-label">Alpenglow vote</span>
                <code class="security-key-value">{ALPENGLOW.vote}</code>
              </div>
            </div>
          </div>
        </div>

        <div class="security-section">
          <h2 class="security-section-title">Solana testnet</h2>
          <div class="security-content">
            <p>
              Solya also runs a node on Solana testnet, the network where new
              Agave and Jito releases are tested before they reach mainnet.
              Like the Alpenglow cluster, it is an isolated environment with
              its own identity and vote keys, fully unrelated to the mainnet
              validator or any of its keys.
            </p>
            <div class="security-keys">
              <div class="security-key-row">
                <span class="security-key-label">Testnet identity</span>
                <code class="security-key-value">{TESTNET.identity}</code>
              </div>
              <div class="security-key-row">
                <span class="security-key-label">Testnet vote</span>
                <code class="security-key-value">{TESTNET.vote}</code>
              </div>
            </div>
          </div>
        </div>

        <div class="security-section">
          <h2 class="security-section-title">Safe staking practices</h2>
          <div class="security-content">
            <p>
              Keep your seed phrase offline and never share it. Use a trusted
              wallet:
              <a href="https://phantom.app" target="_blank" rel="noopener noreferrer">Phantom</a>
              or
              <a href="https://solflare.com" target="_blank" rel="noopener noreferrer">Solflare</a>
              both support native Solana staking. Stake through your wallet's
              staking interface or the options on the
              <a href="/#stake">Stake</a> page. Never send SOL directly to
              any address.
            </p>
          </div>
        </div>

      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .security-page {
    padding-top: calc(64px + 3rem);
    padding-bottom: 5rem;
    min-height: 100vh;
  }

  .security-header {
    max-width: 720px;
    margin-bottom: 3.5rem;
  }

  .security-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: color 0.2s ease;
  }
  .security-back:hover {
    color: var(--accent-cyan);
    opacity: 1;
  }

  .security-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    margin: 0.5rem 0 1rem;
  }

  .security-intro {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 600px;
  }

  .security-sections {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    max-width: 820px;
  }

  .security-section {
    padding: 2rem 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .security-section:last-child {
    border-bottom: none;
  }

  .security-section-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    font-family: var(--font-display);
    margin-bottom: 0.875rem;
  }

  .security-content {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .security-content p {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .security-keys {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .security-key-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .security-key-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    min-width: 90px;
    flex-shrink: 0;
  }

  .security-key-value {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-sm);
    word-break: break-all;
  }

  .security-label-wrap {
  margin-bottom: 0.25rem;
    }

  @media (max-width: 640px) {
    .security-section {
      padding: 1.5rem;
    }
    .security-key-label {
      min-width: 80px;
    }
  }
</style>